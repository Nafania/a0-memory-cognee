# Copy to tests/live/.env.local. Never commit the local file.

# Required for live Agent Zero integration tests.
# Use API_KEY_OPENAI because Agent Zero resolves provider keys from this name.
API_KEY_OPENAI=

# Optional overrides.
A0_MEMORY_COGNEE_CONTAINER=a0-memory-cognee-itest
A0_MEMORY_COGNEE_PORT=18183
A0_MEMORY_COGNEE_IMAGE=agent0ai/agent-zero:latest
A0_MEMORY_COGNEE_FACT_COUNT=20
A0_MEMORY_COGNEE_TIMEOUT=1800
A0_MEMORY_COGNEE_KEEP_CONTAINER=0
# Live runner also writes this into the test container.
A0_SET_cognee_debug_enabled=true
